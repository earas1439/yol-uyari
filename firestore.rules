rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    function validType(t) {
      return t in ['fixedRadar', 'mobileRadar', 'eds', 'trafficControl', 'accident', 'roadwork', 'natural'];
    }

    function validNewHazard(d) {
      return validType(d.type)
        && d.lat is number && d.lat >= -90 && d.lat <= 90
        && d.lng is number && d.lng >= -180 && d.lng <= 180
        && d.geohash5 is string && d.geohash5.size() == 5
        && d.confirmations == 0 && d.denials == 0
        && d.reporterId == request.auth.uid
        && d.source == 'user'                       // kullanıcı 'resmî' kaynak taklidi yapamaz
        && (d.note == null || (d.note is string && d.note.size() <= 200))
        && (d.speedLimit == null || (d.speedLimit is int && d.speedLimit > 0 && d.speedLimit <= 160))
        && (d.expiresAt == null || d.expiresAt < request.time + duration.value(170, 'h'));
    }

    match /hazards/{id} {
      allow read: if true;

      allow create: if signedIn() && validNewHazard(request.resource.data);

      // Sadece oy sayaçları (+ geçici noktanın ömrü) değişebilir,
      // her kullanıcı her noktaya bir kez oy verebilir.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['confirmations', 'denials', 'expiresAt'])
        && request.resource.data.confirmations >= resource.data.confirmations
        && request.resource.data.denials >= resource.data.denials
        && request.resource.data.confirmations + request.resource.data.denials
             == resource.data.confirmations + resource.data.denials + 1
        && (request.resource.data.expiresAt == null
             || request.resource.data.expiresAt < request.time + duration.value(170, 'h'))
        && !exists(/databases/$(database)/documents/hazards/$(id)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/hazards/$(id)/votes/$(request.auth.uid));

      allow delete: if false;

      match /votes/{uid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.value in [1, -1];
        allow update, delete: if false;
      }
    }
  }
}
